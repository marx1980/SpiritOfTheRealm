    "playtest:paired": "node src/playtest/cli.ts paired",
    "playtest:dashboard": "node src/playtest/cli.ts dashboard",
    "playtest:replay": "node src/playtest/cli.ts replay",
    "playtest:shrink": "node src/playtest/cli.ts shrink",
    "playtest:query": "node src/playtest/cli.ts query",
    "playtest:investigate": "node src/playtest/cli.ts investigate",
    "playtest:outbox": "node src/playtest/cli.ts outbox",
